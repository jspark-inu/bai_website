LAB_FEED_SECRET=change-me-use-at-least-32-random-characters
LAB_FEED_COOKIE_SECURE=1
LAB_FEED_DB=/absolute/path/to/bai-data/lab-feed.db
LAB_FEED_DB_READONLY=0
BAI_NEXT_ORIGIN=http://127.0.0.1:5067
# Enable only when the ingress overwrites client-IP headers before forwarding to Next.
BAI_TRUST_PROXY_HEADERS=0
BAI_UPLOAD_DIR=/absolute/path/to/bai-data/uploads
BAI_LIVE_BACKUP_DIR=/absolute/path/to/bai-backups
BAI_ROLLBACK_DIR=/absolute/path/to/bai-code-rollbacks
BAI_MAX_UPLOAD_BYTES=26214400
