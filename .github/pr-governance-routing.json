{
  "contract": "mece-routing-v1",
  "id": "bai-external-pr-governance",
  "purpose": "routing",
  "decision_subject": "BAI 저장소에 열린 외부 pull request의 다음 병합 행동",
  "decision_moment": "PR 생성, 새 커밋 동기화, 재오픈, draft 해제 또는 PI review 제출 시점",
  "canonical_result": "exactly_one_terminal_route",
  "entry_question": "Q1",
  "questions": [
    {
      "id": "Q1",
      "axis": "PI 검토 대기 상태",
      "question": "작성자 신뢰 또는 변경 위험 때문에 검토가 필요하고 현재 head에 유효한 PI 권한 부여가 없는가?",
      "yes": "pi_review",
      "no": "auto_merge"
    }
  ],
  "terminal_routes": {
    "pi_review": {
      "condition": "작성자 신뢰 또는 변경 위험이 감지됐고 현재 head에 유효한 PI 승인이 없다.",
      "action": "위험 사유를 기록하고 기존 auto-merge를 해제한 뒤 PI review를 요청한다.",
      "destination": "GitHub pull request review queue와 BAI PR governance 실행 로그",
      "next_transition": "PI가 현재 head를 승인하거나 작성자가 새 head를 push하면 entry question부터 재판정한다.",
      "review_trigger": "pull_request_review 제출·해제 또는 pull_request synchronize 이벤트에서 즉시 재판정한다."
    },
    "auto_merge": {
      "condition": "현재 head를 PI가 승인했거나 PI가 직접 작성했으며, 또는 신뢰 작성자의 일반 변경이다.",
      "action": "squash auto-merge를 예약하고 필수 pytest와 react checks가 성공할 때까지 기다린다.",
      "destination": "GitHub main branch와 main 자동 배포 파이프라인",
      "next_transition": "필수 checks 성공 시 병합하고 새 커밋이나 review 변경 시 entry question부터 재판정한다."
    }
  },
  "unresolved_route": "pi_review",
  "multi_label_metadata": [
    "author_trust_kind",
    "high_risk_paths",
    "change_scale",
    "security_findings",
    "reason_codes"
  ],
  "policy": {
    "pi_reviewers": [
      "jspark-inu"
    ],
    "trusted_students_registry": ".github/trusted-students.json",
    "required_checks": [
      "pytest",
      "react"
    ],
    "change_limits": {
      "files": 25,
      "lines": 2500
    },
    "high_risk_paths": [
      "/.github/",
      "/scripts/",
      "/backend/",
      "/apps/web/package.json",
      "/apps/web/package-lock.json",
      "/apps/web/next.config.ts",
      "/apps/web/vitest.config.ts",
      "/apps/web/scripts/",
      "/apps/web/src/lib/",
      "/apps/web/src/app/api/",
      "/apps/web/src/app/layout.tsx",
      "/apps/web/src/components/LegacyShell.tsx"
    ],
    "sensitive_path_rules": [
      {
        "id": "environment_secret",
        "pattern": "(^|/)\\.env($|\\.(?!example$)[^/]+$)"
      },
      {
        "id": "private_key_file",
        "pattern": "\\.(pem|key|p12|pfx|jks)$"
      },
      {
        "id": "runtime_database",
        "pattern": "\\.(db|sqlite|sqlite3)([-.].*)?$"
      },
      {
        "id": "credential_bundle",
        "pattern": "(^|/)(credentials|service-account[^/]*)\\.json$"
      }
    ],
    "added_line_secret_rules": [
      {
        "id": "private_key_material",
        "pattern": "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
      },
      {
        "id": "github_token",
        "pattern": "(?:^|[^A-Za-z0-9])(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})"
      },
      {
        "id": "aws_access_key",
        "pattern": "(?:^|[^A-Z0-9])AKIA[0-9A-Z]{16}(?:$|[^A-Z0-9])"
      }
    ]
  }
}
